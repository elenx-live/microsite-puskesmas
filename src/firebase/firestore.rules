rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/roles/$(getUserData().roleId)).data;
    }

    function hasPermission(permissionCode) {
      return isAuthenticated() && 
        permissionCode in getUserRole().permissions;
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
        getUserData().roleId == 'role-superadmin';
    }

    // Default DENY ALL
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS COLLECTION
    match /users/{userId} {
      // Users can read their own profile, SuperAdmin/Admin can read all users
      allow read: if isAuthenticated() && (request.auth.uid == userId || hasPermission('manage_users'));
      // Only SuperAdmin or users with manage_users permission can create/update users
      allow create, update: if isSuperAdmin() || hasPermission('manage_users');
      // Users cannot change their own roleId unless SuperAdmin
      allow update: if isAuthenticated() && 
        request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roleId', 'status']);
      allow delete: if isSuperAdmin();
    }

    // ROLES & PERMISSIONS COLLECTION
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || hasPermission('manage_roles_permissions');
    }

    match /permissions/{permissionId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // HEALTH SERVICES & CLUSTERS (PERMENKES 19/2024)
    match /services/{serviceId} {
      allow read: if true; // Public read
      allow write: if hasPermission('manage_services_clusters');
    }

    match /serviceStandards/{standardId} {
      allow read: if true; // Public read
      allow write: if hasPermission('manage_service_standards');
    }

    match /serviceClusters/{clusterId} {
      allow read: if true;
      allow write: if hasPermission('manage_services_clusters');
    }

    match /serviceCategories/{categoryId} {
      allow read: if true;
      allow write: if hasPermission('manage_services_clusters');
    }

    match /serviceUnits/{unitId} {
      allow read: if true;
      allow write: if hasPermission('manage_services_clusters');
    }

    match /serviceLocations/{locationId} {
      allow read: if true;
      allow write: if hasPermission('manage_services_clusters');
    }

    match /serviceRequirements/{requirementId} {
      allow read: if true;
      allow write: if hasPermission('manage_services_clusters') || hasPermission('edit_service_requirements') || hasPermission('create_service_requirements');
    }

    match /serviceProcedures/{procedureId} {
      allow read: if true;
      allow write: if hasPermission('manage_services_clusters') || hasPermission('edit_service_procedures') || hasPermission('create_service_procedures');
    }

    match /serviceProducts/{productId} {
      allow read: if true;
      allow write: if hasPermission('manage_services_clusters') || hasPermission('edit_service_products') || hasPermission('create_service_products');
    }

    match /serviceSchedules/{scheduleId} {
      allow read: if true;
      allow write: if hasPermission('manage_services_clusters') || hasPermission('edit_service_schedules') || hasPermission('create_service_schedules');
    }

    match /serviceScheduleExceptions/{exceptionId} {
      allow read: if true;
      allow write: if hasPermission('manage_services_clusters') || hasPermission('edit_service_schedule_exceptions') || hasPermission('create_service_schedule_exceptions');
    }

    match /servicePricing/{pricingId} {
      allow read: if true;
      allow write: if hasPermission('manage_services_clusters') || hasPermission('edit_service_pricing') || hasPermission('create_service_pricing');
    }

    // CONTENT (PAGES, POSTS, MEDIA, ANNOUNCEMENTS)
    match /pages/{pageId} {
      allow read: if resource.data.status == 'published' || hasPermission('manage_pages_menus');
      allow write: if hasPermission('manage_pages_menus');
    }

    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || hasPermission('manage_posts_announcements');
      allow write: if hasPermission('manage_posts_announcements');
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if hasPermission('manage_media');
    }

    // HOMEPAGE & THEME SETTINGS
    match /homepageSections/{sectionId} {
      allow read: if true;
      allow write: if hasPermission('manage_homepage_builder') || hasPermission('publish_homepage');
    }

    match /themes/{themeId} {
      allow read: if true;
      allow write: if hasPermission('manage_theme_header_footer');
    }

    // MICROSITES
    match /microsites/{micrositeId} {
      // Public can read public microsites
      allow read: if resource.data.status == 'published' || hasPermission('manage_microsites');
      allow write: if hasPermission('manage_microsites');
    }

    // SITE SETTINGS
    match /siteSettings/{settingId} {
      allow read: if true; // Public read site info
      allow write: if hasPermission('manage_site_settings');
    }

    // SYSTEM BACKUPS (ADMIN / SUPERADMIN ONLY)
    match /backups/{backupId} {
      allow read, write: if isSuperAdmin() || hasPermission('manage_system_backups') || hasPermission('manage_site_settings');
    }

    // COMPLAINTS & FEEDBACK
    match /complaints/{complaintId} {
      allow create: if true; // Public submission
      allow read: if isAuthenticated() && (hasPermission('manage_complaints') || resource.data.trackingCode == request.auth.uid);
      allow update, delete: if isSuperAdmin() || hasPermission('manage_complaints');
    }

    // REGISTRATIONS & ONLINE APPOINTMENTS
    match /registrations/{registrationId} {
      allow create: if true; // Public registration
      allow read: if isAuthenticated() && (hasPermission('manage_registrations') || resource.data.nik == request.auth.uid);
      allow update, delete: if isSuperAdmin() || hasPermission('manage_registrations');
    }

    // AUDIT LOGS (APPEND-ONLY FOR AUTHORIZED USERS)
    match /auditLogs/{logId} {
      allow read: if hasPermission('view_audit_logs') || isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable logs
    }
  }
}
